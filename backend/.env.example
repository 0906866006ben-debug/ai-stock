# Copy this file to .env and fill in your keys.
# All keys are optional — the system returns mock data when any key is absent.

GEMINI_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=

# Optional CORS override (default: *)
# CORS_ORIGINS=http://localhost:3000

FINMIND_API_KEY=

# Telegram Bot (optional — enables /tw/telegram/* endpoints)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEB_CHAT_ID=
