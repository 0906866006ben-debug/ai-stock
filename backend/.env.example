# AI Stock backend environment
# All external provider keys are optional. Empty values use mock/fallback data.

# Gemini AI analysis
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=
GEMINI_API_KEY=

# US market data
# FMP: fundamentals, peers, market overview, search
FMP_API_KEY=
# Finnhub: US company news
FINNHUB_API_KEY=
# Polygon: US historical prices
POLYGON_API_KEY=

# Taiwan market data
SERPAPI_KEY=
FINMIND_API_KEY=

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEB_CHAT_ID=

# =========================
# Claude / Anthropic API (closed-loop optimizer)
# =========================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
CLAUDE_ENABLED=true
CLAUDE_ADVISOR_MODEL=claude-sonnet-4-6
CLAUDE_ADVISOR_FALLBACK_MODEL=claude-sonnet-4-6
CLAUDE_ADVISOR_MAX_TOKENS=1200
CLAUDE_TIMEOUT=90
CLAUDE_MAX_TOKENS=1200
# closed-loop optimizer knobs
AUTO_OPTIMIZE_ENABLED=true
AUTO_OPTIMIZE_DRY_RUN=false
AUTO_OPTIMIZE_MAX_ITERATIONS=10
AUTO_OPTIMIZE_TRIALS_PER_ITER=50
AUTO_OPTIMIZE_REPAIR_ATTEMPTS=2
AUTO_OPTIMIZE_ROLLBACK_ON_REGRESSION=true
AUTO_OPTIMIZE_STOP_ON_SUCCESS=true
AUTO_OPTIMIZE_STAGNATION_ITERS=3
AUTO_OPTIMIZE_MIN_IMPROVEMENT=0.01
# Never invoke the Claude Code CLI — only Claude API
CLAUDE_CODE_CLI_ENABLED=false