# Copy this file to backend/.env and fill in the keys you want to use.
# All external provider keys are optional. Empty values use mock/fallback data.

# Gemini AI analysis
# Set GEMINI_ENABLED=false to force fallback analysis even when GEMINI_API_KEY is set.
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=
GEMINI_API_KEY=

# US market data
# FMP: fundamentals, peers, market overview, search
FMP_API_KEY=
# Finnhub: US company news
FINNHUB_API_KEY=
# Polygon: US historical prices
POLYGON_API_KEY=

# Taiwan market data
# FinMind: TW prices, stock list, fundamentals, dividends, chip data
FINMIND_API_KEY=


