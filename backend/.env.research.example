# Research API and local persistence
AI_STOCK_BACKEND_TOKEN=
RESEARCH_API_REQUIRE_AUTH=true
CRYPTO_BACKTEST_DB=C:/Users/your-user/.crypto_backtest/klines.db
CRYPTO_BACKTEST_RUNS=backend/data/crypto_backtest/runs
RESEARCH_METADATA_DB=backend/data/research_platform/research.db
RESEARCH_API_PORT=8000
LIVE_TRADING_ENABLED=false

# Production metadata and distributed coordination (not used by the SQLite slice)
DATABASE_URL=
REDIS_URL=

# OpenAI event mode
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.6-sol
OPENAI_MAX_AUTOMATIC_CALLS_PER_MONTH=2
OPENAI_MAX_MANUAL_CALLS_PER_MONTH=2
OPENAI_MAX_TOTAL_CALLS_PER_MONTH=4
OPENAI_MONTHLY_TARGET_USD=1.50
OPENAI_MONTHLY_HARD_STOP_USD=4.50
OPENAI_MIN_DAYS_BETWEEN_AUTOMATIC_CALLS=7
OPENAI_MIN_NEW_VALID_BACKTESTS=10000
OPENAI_MAX_INPUT_TOKENS=10000
OPENAI_MAX_OUTPUT_TOKENS=1500
OPENAI_REASONING_EFFORT=medium

